# Contact form (api/inquiry.js). Set these in the Vercel dashboard:
# Project -> Settings -> Environment Variables. Never commit real values.

# API key from https://resend.com (free tier is enough for a portfolio)
RESEND_API_KEY=

# Where enquiries are delivered
INQUIRY_TO=pranawgautam@gmail.com

# Optional. Defaults to Resend's sandbox sender, which needs no domain setup.
# Change once you verify your own domain with Resend.
INQUIRY_FROM=Portfolio <onboarding@resend.dev>
